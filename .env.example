# Core
DATABASE_URL=sqlite:///./data/uk_etdi.db
APP_ENV=development
LOG_LEVEL=INFO
API_ADMIN_TOKEN=

# Taxi business context
SERVICE_AREA_CITIES=London,Manchester,Birmingham,Leeds,Liverpool
HOME_CITY=London

# Optional source keys (collectors auto-disable when missing)
TICKETMASTER_API_KEY=
EVENTBRITE_API_KEY=
JAMBASE_API_KEY=

# Optional notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional outputs
GOOGLE_SHEETS_WEBHOOK=

# Phase 2
LOG_FORMAT=text            # text | json (structured logs for CI/log shipping)
RETENTION_RAW_DAYS=30
RETENTION_SNAPSHOT_DAYS=180
RETENTION_HEALTH_DAYS=60
RETENTION_RUNS_DAYS=365
# SERVICE_AREA_CITIES above is only a generic default; override at runtime via Settings → service_area_cities (admin token).
